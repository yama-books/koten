{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-meta.schema.json",
  "title": "Hentaigana Life Node Run Metadata",
  "type": "object",
  "required": [
    "runId",
    "engineVersion",
    "worldSchemaVersion",
    "characterDataVersion",
    "seed",
    "createdAt",
    "eventLevel",
    "runner"
  ],
  "properties": {
    "runId": {
      "type": "string"
    },
    "engineVersion": {
      "type": "string"
    },
    "worldSchemaVersion": {
      "type": "string"
    },
    "characterDataVersion": {
      "type": "string"
    },
    "sourceCommit": {
      "type": [
        "string",
        "null"
      ]
    },
    "seed": {
      "type": "integer"
    },
    "createdAt": {
      "type": "string"
    },
    "snapshotEveryTicks": {
      "type": "integer",
      "minimum": 1
    },
    "eventLevel": {
      "enum": [
        "all",
        "observation"
      ]
    },
    "runner": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "batch",
        "continuous"
      ]
    },
    "sourceDirty": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "compatibility": {
      "type": "object",
      "required": [
        "scheme",
        "fingerprint",
        "files"
      ],
      "properties": {
        "scheme": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "eventLayout": {
      "enum": [
        "chunked-v1"
      ]
    },
    "tickMs": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
