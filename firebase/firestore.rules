rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function nonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isValidStats(data, docId, official) {
      return data.keys().hasOnly([
        'clientNumber', 'localDate', 'product', 'grade', 'pageViews', 'buttonCounts',
        'entryCounts', 'questionTypeCounts', 'attemptCount', 'masteryAvg', 'masteryMax',
        'masteryDistribution', 'isOfficial', 'appVersion', 'dataVersion',
        'masteryRulesVersion', 'expiresAt'
      ])
        && data.keys().hasAll([
          'clientNumber', 'localDate', 'product', 'grade', 'pageViews', 'buttonCounts',
          'entryCounts', 'questionTypeCounts', 'attemptCount', 'masteryAvg', 'masteryMax',
          'masteryDistribution', 'isOfficial', 'appVersion', 'dataVersion',
          'masteryRulesVersion', 'expiresAt'
        ])
        && data.clientNumber is string && data.clientNumber.matches('^[a-z0-9]{20}$')
        && data.localDate is string && data.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.expiresAt is timestamp
        && data.product in ['hyakunin', 'kanazukai']
        && data.grade is string
        && data.pageViews is int && data.pageViews >= 0
        && data.attemptCount is int && data.attemptCount >= 0
        && data.masteryAvg is number && data.masteryAvg >= 0 && data.masteryAvg <= 100
        && data.masteryMax is number && data.masteryMax >= 0 && data.masteryMax <= 100
        && data.masteryDistribution is list && data.masteryDistribution.size() == 5
        && data.isOfficial is bool
        && data.appVersion is string
        && nonNegativeInt(data.dataVersion)
        && nonNegativeInt(data.masteryRulesVersion)
        && data.buttonCounts is map
        && data.buttonCounts.keys().hasAll(['start', 'answer', 'hint', 'reveal', 'history', 'report'])
        && data.buttonCounts.keys().size() == 6
        && nonNegativeInt(data.buttonCounts.start)
        && nonNegativeInt(data.buttonCounts.answer)
        && nonNegativeInt(data.buttonCounts.hint)
        && nonNegativeInt(data.buttonCounts.reveal)
        && nonNegativeInt(data.buttonCounts.history)
        && nonNegativeInt(data.buttonCounts.report)
        && data.entryCounts is map
        // 公開済みの5キー版を止めずに author を受け入れる移行期間。
        // hasOnly で未知のキーを拒み、hasAll で従来5キーを必須にする。
        && data.entryCounts.keys().hasOnly(['quick', 'view', 'learn', 'review', 'exam', 'author'])
        && data.entryCounts.keys().hasAll(['quick', 'view', 'learn', 'review', 'exam'])
        && nonNegativeInt(data.entryCounts.quick)
        && nonNegativeInt(data.entryCounts.view)
        && nonNegativeInt(data.entryCounts.learn)
        && nonNegativeInt(data.entryCounts.review)
        && nonNegativeInt(data.entryCounts.exam)
        && (!data.entryCounts.keys().hasAll(['author']) || nonNegativeInt(data.entryCounts.author))
        && data.questionTypeCounts is map
        && data.questionTypeCounts.keys().hasAll(['blank', 'author'])
        && data.questionTypeCounts.keys().size() == 2
        && nonNegativeInt(data.questionTypeCounts.blank)
        && nonNegativeInt(data.questionTypeCounts.author)
        && nonNegativeInt(data.masteryDistribution[0])
        && nonNegativeInt(data.masteryDistribution[1])
        && nonNegativeInt(data.masteryDistribution[2])
        && nonNegativeInt(data.masteryDistribution[3])
        && nonNegativeInt(data.masteryDistribution[4])
        && data.isOfficial == official
        && docId == data.clientNumber + '_' + data.localDate + '_' + data.product;
    }

    match /stats_days_test/{docId} {
      allow create: if isValidStats(request.resource.data, docId, false);
      allow get, list, update, delete: if false;
    }

    match /stats_days_official/{docId} {
      allow create: if isValidStats(request.resource.data, docId, true);
      allow get, list, update, delete: if false;
    }

    function isCiphertextPayload(payload) {
      return payload.keys().hasOnly(['enc'])
        && payload.enc is string
        && payload.enc.matches('^enc:.+$');
    }

    // New app data uses a separate invitation capability, not the legacy public
    // houseId. There is no group directory. Knowing the invitation is the grant
    // to enroll one's own anonymous UID; UIDs alone grant no record access.
    match /sharedGroups/{capability} {
      function signedIn() { return request.auth != null; }
      function member() {
        return signedIn() && exists(/databases/$(database)/documents/sharedGroups/$(capability)/members/$(request.auth.uid));
      }
      allow get: if signedIn() && capability.matches('^[a-f0-9]{64}$');
      allow create: if signedIn() && capability.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['version','enc'])
        && request.resource.data.version == 1
        && request.resource.data.enc is string && request.resource.data.enc.matches('^enc:.+$')
        && request.resource.data.enc.size() <= 4096;
      allow list, update, delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid
          && exists(/databases/$(database)/documents/sharedGroups/$(capability))
          && request.resource.data.keys().hasOnly(['version']) && request.resource.data.version == 1;
        allow list, update, delete: if false;
      }
      match /apps/{appId}/records/{recordId} {
        allow get: if member() && appId in ['vintage-kana','conj'];
        allow list: if member() && appId in ['vintage-kana','conj']
          && request.query.limit != null && request.query.limit <= 200;
        allow create: if member() && appId in ['vintage-kana','conj']
          && recordId.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['enc','createdAt'])
          && request.resource.data.enc is string && request.resource.data.enc.matches('^enc:.+$')
          && request.resource.data.createdAt == request.time
          && request.resource.data.enc.size() <= 750000;
        allow update, delete: if false;
      }
      match /apps/hyakunin/{kind}/{id} {
        allow get, list: if member() && kind in ['events','sessions','reports'];
        allow create: if member() && kind in ['events','sessions','reports']
          && isCiphertextPayload(request.resource.data) && request.resource.data.enc.size() <= 750000;
        allow update: if member() && kind == 'sessions' && isCiphertextPayload(request.resource.data);
        allow delete: if member() && kind in ['events','sessions','reports'];
      }
      match /apps/hyakunin/settings/current {
        allow get: if member();
        allow create, update: if member() && isCiphertextPayload(request.resource.data);
        allow list, delete: if false;
      }
    }

    // Legacy hyakunin clients retain their original paths and permissions.
    // This compatibility block does not provide membership authorization.
    match /households/{houseId} {
      match /{recordKind}/{recordId} {
        allow create: if recordKind in ['sessions', 'events', 'reports']
          && isCiphertextPayload(request.resource.data);
        allow get: if recordKind in ['sessions', 'events', 'reports'];
        // houseId は無作為な合言葉の SHA-256。購読には list が必要。
        allow list: if recordKind in ['sessions', 'events', 'reports'];
        // セッションは開始時と完了時に同じ ID で保存する。
        allow update: if recordKind == 'sessions' && isCiphertextPayload(request.resource.data);
        // 記録を消せるようにする（依頼者・2026-09-22）。**消せないと、端末から消しても戻ってくる。**
        // 合言葉を知っている者だけが houseId を作れるので、読み書きと同じ信頼の境目である。
        allow delete: if recordKind in ['sessions', 'events', 'reports'];
      }

      match /settings/{settingsId} {
        allow create, update: if settingsId == 'current' && isCiphertextPayload(request.resource.data);
        allow get: if settingsId == 'current';
        allow list, delete: if false;
      }
    }
  }
}
