      "volume": "",
      "part": ""
    },
    {
      "id": "adjv-032",
      "lemmaId": "adjv-lemma-041",
      "target": "なべてなら",
      "occurrence": 0,
      "excerpt": "さまざまの御祈りはじまりて、なべてならぬ法ども行はるれど、さらにそのしるしなし。",
      "work": "方丈記",
      "volume": "",
      "part": ""
    },
    {
      "id": "adjv-092",
      "lemmaId": "adjv-lemma-042",
      "target": "なほざりに",
      "occurrence": 0,
      "excerpt": "「しかじかの人のもとになむ。なほざりにやはべる」と聞こゆ。",
      "work": "堤中納言物語",
      "volume": "",
      "part": ""
    },
    {
      "id": "adjv-090",
      "lemmaId": "adjv-lemma-044",
      "target": "にはかに",
      "occurrence": 0,
      "excerpt": "また、治承四年水無月のころ、にはかに都遷り侍りき。いと思ひの外なりし事なり。",
