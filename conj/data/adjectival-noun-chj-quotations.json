      "part": ""
    },
    {
      "id": "adjv-088",
      "lemmaId": "adjv-lemma-012",
      "target": "いるがせに",
      "occurrence": 0,
      "excerpt": "なかんづく、末代の流れにおよびて、人驕つて朝威をいるがせにし、民は武くして野心をさしはさむ。",
      "work": "平治物語",
      "volume": "信頼信西不快の事",
      "part": "上"
    },
    {
      "id": "adjv-039",
      "lemmaId": "adjv-lemma-018",
      "target": "おろそかなら",
      "occurrence": 0,
      "excerpt": "ただ吾山の興隆をのみ思へり。又国家を祈り奉る事おろそかならず、衆徒をはぐくむ心ざしもふかかりき。",
      "work": "平家物語",
      "volume": "一行阿闍梨之沙汰",
      "part": "巻二"
    },
    {
      "id": "adjv-069",
      "lemmaId": "adjv-lemma-020",
      "target": "きびはなる",
      "occurrence": 0,
      "excerpt": "十四五ばかりの子ども見えて、いと若くきびはなるかぎり十二、三ばかり、ありつる童のやうなる子どもなどして、…",
      "work": "堤中納言物語",
      "volume": "",
      "part": ""
    },
    {
